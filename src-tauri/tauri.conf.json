{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YM Vinil",
  "version": "1.0.0",
  "identifier": "dev.ymvinil.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YM Vinil",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://avatars.yandex.net; media-src 'self' blob: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxMjJFNTNGRjQ1M0MwMDkKUldRSndGUDBQK1Vpa2N3QUtJUVBQWmNJaU5BZmNnWk1pWXdvKzZ1VTE5Z1k0dXl2YXpWTUlYelYK",
      "endpoints": [
        "https://github.com/474K474/YM_vinil/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
